# Quickshell desktop shell: top bar, session menu, app launcher and
# notification daemon (replaces waybar, rofi and dunst).  QML lives in ./qml; only Theme.qml is generated, from
# the palette and vars, so the shell never hardcodes a colour.
#
#   qs -c shell ipc call bar     toggle|show|hide
#   qs -c shell ipc call session toggle|open
#   qs -c shell ipc call launcher toggle
#   qs -c shell ipc call rec     start|stop
{
  config,
  lib,
  pkgs,
  osConfig,
  ...
}: let
  inherit (config) vars;
  c = config.colorScheme.palette;

  theme = pkgs.writeText "Theme.qml" ''
    pragma Singleton

    import QtQuick
    import Quickshell

    // Generated by home/shell/quickshell/default.nix.
    Singleton {
        readonly property color bg: "#${c.base00}"
        readonly property color surface: "#${c.base01}"
        readonly property color overlay: "#${c.base02}"
        readonly property color subtle: "#${c.base03}"
        readonly property color muted: "#${c.base04}"
        readonly property color fg: "#${c.base05}"
        readonly property color fgBright: "#${c.base06}"
        readonly property color red: "#${c.base08}"
        readonly property color orange: "#${c.base09}"
        readonly property color yellow: "#${c.base0A}"
        readonly property color green: "#${c.base0B}"
        readonly property color teal: "#${c.base0C}"
        readonly property color blue: "#${c.base0D}"
        readonly property color purple: "#${c.base0E}"
        readonly property color accent: "#${c.base0C}"

        readonly property string font: "${vars.font.name}"
        readonly property string mono: "${vars.font.name}"
        readonly property int fontSize: 15
        readonly property string iconFont: "Material Symbols Rounded"

        readonly property int barHeight: 28
        readonly property int barRadius: ${toString vars.barRounding}
        readonly property int radius: ${toString vars.rounding}

        readonly property string terminal: "${vars.terminal}"
        readonly property var persistentWorkspaces: ${builtins.toJSON config.monitors.workspaces}

        function alpha(c, a) { return Qt.rgba(c.r, c.g, c.b, a); }
    }
  '';

  shellDir = pkgs.runCommand "quickshell-shell" {} ''
    cp -r ${./qml} $out
    chmod u+w $out
    cp ${theme} $out/Theme.qml
  '';
in {
  home.packages = [pkgs.quickshell pkgs.material-symbols];

  xdg.configFile."quickshell/shell".source = shellDir;

  systemd.user.services.quickshell = {
    Unit = {
      Description = "Quickshell desktop shell (bar, launcher, notifications, session menu)";
      PartOf = ["graphical-session.target"];
      After = ["graphical-session.target"];
      X-Restart-Triggers = ["${shellDir}"];
    };
    Service = {
      ExecStart = "${pkgs.quickshell}/bin/qs -c shell";
      Restart = "on-failure";
      RestartSec = 1;
      # Apps started from the launcher are children of this service; don't
      # take them down when the shell restarts (e.g. on a rebuild).
      KillMode = "process";
      # Everything the shell runs, ahead of the session PATH.
      Environment = "PATH=${lib.makeBinPath [
        osConfig.programs.hyprland.package
        pkgs.${vars.terminal}
        pkgs.bash
        pkgs.coreutils
        pkgs.gawk
        pkgs.hyprlock
        pkgs.libnotify
        pkgs.networkmanager
        pkgs.pavucontrol
        pkgs.btop
        pkgs.systemd
        pkgs.wl-clipboard
        pkgs.xdg-utils
      ]}:/run/wrappers/bin:/etc/profiles/per-user/${config.home.username}/bin:/run/current-system/sw/bin";
    };
    Install.WantedBy = ["graphical-session.target"];
  };
}
